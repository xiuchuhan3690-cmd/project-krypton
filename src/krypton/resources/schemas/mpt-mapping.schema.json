  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "$ref": "#/$defs/ApplicabilityContext"
    },
    "callable_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
