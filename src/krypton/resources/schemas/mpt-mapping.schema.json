          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "parameter_id": {
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "physical_dimension": {
          "minLength": 1,
          "title": "Physical Dimension",
          "type": "string"
        },
        "quantity_kind": {
          "minLength": 1,
          "title": "Quantity Kind",
          "type": "string"
        },
        "valid_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
