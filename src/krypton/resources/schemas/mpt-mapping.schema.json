        "experimental_system": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Experimental System",
          "type": "array"
        },
        "medications": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Medications",
          "type": "array"
        },
        "population_ancestry": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Population Ancestry",
          "type": "array"
        },
        "sex": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sex",
          "type": "array"
        },
        "tissue": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tissue",
          "type": "array"
        }
      },
      "title": "ApplicabilityContext",
      "type": "object"
    },
    "LookupEntry": {
      "additionalProperties": false,
      "properties": {
        "source_value": {
          "title": "Source Value",
          "type": "number"
        },
        "target_value": {
          "title": "Target Value",
          "type": "number"
        }
      },
      "required": [
        "source_value",
        "target_value"
      ],
      "title": "LookupEntry",
      "type": "object"
    },
    "MappingType": {
      "enum": [
        "identity",
        "scale",
        "lookup",
        "callable"
      ],
      "title": "MappingType",
      "type": "string"
    },
    "ParameterRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        }
      },
      "title": "ParameterRange",
      "type": "object"
    },
    "TargetParameterReference": {
      "additionalProperties": false,
      "description": "MPT's narrow boundary reference to a future model contract parameter.",
      "properties": {
        "biological_meaning": {
          "minLength": 1,
          "title": "Biological Meaning",
          "type": "string"
        },
        "canonical_unit": {
          "minLength": 1,
          "title": "Canonical Unit",
          "type": "string"
        },
        "contract_id": {
          "minLength": 1,
