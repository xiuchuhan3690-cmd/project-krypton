    "AgeRange": {
      "additionalProperties": false,
      "properties": {
        "maximum_years": {
          "minimum": 0,
          "title": "Maximum Years",
          "type": "number"
        },
        "minimum_years": {
          "minimum": 0,
          "title": "Minimum Years",
          "type": "number"
        }
      },
      "required": [
        "minimum_years",
        "maximum_years"
      ],
      "title": "AgeRange",
      "type": "object"
    },
