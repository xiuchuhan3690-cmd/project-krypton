      },
      "required": [
        "contract_id",
        "contract_version",
        "parameter_id",
        "biological_meaning",
        "quantity_kind",
        "canonical_unit",
        "physical_dimension"
      ],
      "title": "TargetParameterReference",
      "type": "object"
    }
