      "title": "Id",
      "type": "string"
    },
    "lookup_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LookupEntry"
      },
      "title": "Lookup Entries",
      "type": "array"
    },
    "mapping_type": {
      "$ref": "#/$defs/MappingType"
    },
    "scale_factor": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scale Factor"
    },
    "source_quantity_kind": {
      "minLength": 1,
      "title": "Source Quantity Kind",
      "type": "string"
    },
    "source_unit": {
      "minLength": 1,
      "title": "Source Unit",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/TargetParameterReference"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "mapping_type",
    "source_quantity_kind",
    "source_unit",
    "target",
    "evidence_ids",
    "applicability"
  ],
  "title": "MPTMappingDefinition",
  "type": "object"
}
